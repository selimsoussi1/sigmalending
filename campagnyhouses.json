    {
      "parameters": {
        "jsCode": "// Get the response from the previous node\nconst data = items[0].json;\n\n// The filings are in data.items\nconst filings = data.items || [];\n\n// Filter only accounts filings\nconst accounts = filings.filter(f => f.category === 'accounts');\n\n// Throw an error if none found\nif (accounts.length === 0) {\n    throw new Error(\"No account filings found\");\n}\n\n// Sort by made-up date descending to get the latest\naccounts.sort((a, b) => {\n    const dateA = a.description_values?.made_up_date || '1900-01-01';\n    const dateB = b.description_values?.made_up_date || '1900-01-01';\n    return new Date(dateB) - new Date(dateA);\n});\n\n// Take the first (latest) account filing\nconst latestAccount = accounts[0];\n\n// Pass transaction_id to the next node\nreturn [\n    {\n        json: {\n            transaction_id: latestAccount.transaction_id\n        }\n    }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
